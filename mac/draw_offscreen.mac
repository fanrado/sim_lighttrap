# ─────────────────────────────────────────────────────────────────────────────
# draw_offscreen.mac — headless geometry pictures (first layer + PMT).
#
#   ./sim_lighttrap draw_offscreen.mac        (batch; no display needed)
#
# Writes PNGs with the TOOLSSG offscreen renderer and prints the volume tree
# (solids, materials, sensitive detectors) with ASCIITree. The offscreen
# z-buffer renderer skips translucent surfaces, so opaque colours are forced
# here; the thin counters are hidden. Note: the RayTracer driver segfaults in
# this Geant4 11.3.2 build, so it is not used.
#
# Rough pTP film: add rough=on on the command line (or set ROUGH=1 in the
# environment) to apply the same roughness_knobs.mac as vis_roughness.mac
# (bumpy 1 mm film, 400 nm beam):
#     ./sim_lighttrap draw_offscreen.mac rough=on
# Without it the standard geometry (flat 2 µm film, 128 nm beam) is drawn.
# The {ROUGH} alias (0/1) is defined by sim_lighttrap itself.
# For interactive inspection use vis.mac / vis_roughness.mac (Qt viewer).
# ─────────────────────────────────────────────────────────────────────────────

/control/if {ROUGH} == 1 roughness_knobs.mac
/run/initialize

# ── volume tree ────────────────────────────────────────────────────────────
/vis/ASCIITree/verbose 15
/vis/drawTree ! ATree

# ── offscreen renderer setup ───────────────────────────────────────────────
/vis/open TSG_OFFSCREEN
/vis/tsg/offscreen/set/size 1600 1200
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge true
/vis/viewer/set/lineSegmentsPerCircle 120
# culling must be ON, otherwise the (invisible) world box is drawn and its inner
# walls hide everything in the zoomed views
/vis/viewer/set/culling global true
/vis/viewer/set/culling invisible true
/vis/drawVolume
/vis/geometry/set/visibility logicWorld 0 false
/vis/geometry/set/colour logicpTPlayer 0 1 0.85 0 1
/vis/geometry/set/colour logicUVAcrylic 0 0.45 0.75 1 1
/vis/geometry/set/colour logicPMTPhotocathode 0 0.75 0.1 0.1 1
/vis/geometry/set/colour logicPMTWindow 0 0.85 0.9 1 1
/vis/geometry/set/colour logicPMTEnvelope 0 0.6 0.6 0.65 1
/vis/geometry/set/colour logicPMTEndCap 0 0.6 0.6 0.65 1
/vis/geometry/set/visibility logicPMTVacuum 0 false
/vis/geometry/set/visibility logicFirstLayerExitDet 0 false
/vis/geometry/set/visibility logicFirstLayerEdgeDet 0 false
/vis/viewer/set/background 1 1 1
/vis/scene/add/axes 0 0 0 20 mm

# 1) oblique from the beam side (-z): 15 cm first layer with the PMT tube behind it
/vis/tsg/offscreen/set/file pmt_geom_oblique.png
/vis/viewer/set/viewpointThetaPhi 125 40 deg
/vis/viewer/set/upVector 0 1 0
/vis/viewer/zoomTo 1
/vis/viewer/flush

# 2) straight view from the PMT side (+z): tube / faceplate diameter vs module
/vis/tsg/offscreen/set/file pmt_geom_back.png
/vis/viewer/set/viewpointVector 0 0 1
/vis/viewer/set/upVector 0 1 0
/vis/viewer/zoomTo 1
/vis/viewer/flush

# 3) side view (looking along +x): whole PMT cylinder behind the first layer
/vis/tsg/offscreen/set/file pmt_geom_side.png
/vis/viewer/set/viewpointVector -1 -0.15 0.1
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/targetPoint 0 0 40 mm
/vis/viewer/zoomTo 1.6
/vis/viewer/flush

# 3b) side close-up on the gap: acrylic back face, 7 mm LAr gap, faceplate, photocathode
/vis/tsg/offscreen/set/file pmt_geom_side_gap.png
/vis/viewer/set/viewpointVector -1 -0.15 0.1
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/targetPoint 0 0 -3 mm
/vis/viewer/zoomTo 7
/vis/viewer/flush

# 4) side view with 30 beam photons (circle, Ø14 mm) and their WLS daughters
/vis/tsg/offscreen/set/file pmt_geom_side_tracks.png
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton blue
/vis/scene/endOfEventAction accumulate 100
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/targetPoint 0 0 -8 mm
/vis/viewer/zoomTo 2.5
# 128 nm beam; with ROUGH=1 a 400 nm beam that pTP does not absorb, so the
# deflection by the bumps is visible
/control/alias beamE 9.68
/control/if {ROUGH} == 1 beam_400nm_alias.mac
/gps/particle opticalphoton
/gps/energy {beamE} eV
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0. 0. -10. cm
/gps/pos/radius 7 mm
/gps/direction 0 0 1
/run/beamOn 500
/vis/viewer/flush

# 5) close-up of the pTP film with the same events (shows the bumps with ROUGH=1)
/vis/tsg/offscreen/set/file pmt_geom_film_closeup.png
/vis/viewer/set/viewpointVector -1 -0.05 0.02
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/targetPoint 0 0 -9 mm
/vis/viewer/zoomTo 9
/vis/viewer/flush

