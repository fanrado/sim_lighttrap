# ─────────────────────────────────────────────────────────────────────────────
# vis.mac — interactive Qt visualisation (executed automatically by ./sim_lighttrap
# with no arguments, or ./sim_lighttrap vis.mac).
#
# Shows the first layer (pTP film: yellow, UV acrylic: light blue) and the PMT
# cylinder (MgF2 faceplate at z = 0, dark red photocathode Ø 23 mm behind it,
# grey glass envelope). The 14 mm circular VUV beam is preloaded: use the Run
# menu or "/run/beamOn 30" to see trajectories.
#
# Driver: TOOLSSG Qt (TSG), the Geant4 11 recommended Qt viewer; it is the
# on-screen twin of the TSG_OFFSCREEN renderer used by draw_offscreen.mac, so
# what you see here is what the validated PNGs show.  Do not use Qt3D (it did
# not draw the WLS secondaries in this build) or OGL (blank window with Qt6 on
# macOS).  Trajectories are coloured by particle: optical photons blue.
# Export the current view from the session:  /vis/tsg/export zb_png view.png
# Cross-check without a display:              ./sim_lighttrap draw_offscreen.mac
# ─────────────────────────────────────────────────────────────────────────────
/vis/open TSG
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/hiddenEdge true
/vis/viewer/set/culling global true
/vis/viewer/set/culling invisible true
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
/vis/scene/add/scale 10 cm
/vis/scene/add/axes
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton blue
/vis/modeling/trajectories/drawByParticleID-0/default/setDrawStepPts false
/vis/scene/add/eventID
/vis/scene/endOfEventAction accumulate 100

# File menu :
/gui/addMenu file File
/gui/addButton file Quit exit

# Camera menu:
/gui/addMenu camera Camera
/gui/addButton camera "Front" "/vis/viewer/set/viewpointVector 0 0 1"
/gui/addButton camera "Side"  "/vis/viewer/set/viewpointVector -1 0 0"
/gui/addButton camera "Top"   "/vis/viewer/set/viewpointVector 0 -1 0"
/gui/addButton camera "Reset"   "/vis/viewer/set/viewpointVector -1 1 1"

# Run menu :
/gui/addMenu run Run
/gui/addButton run "beamOn 1"  "/run/beamOn 1"
/gui/addButton run "beamOn 30" "/run/beamOn 30"

# 14 mm diameter parallel VUV beam (same as run.mac)
/gps/particle opticalphoton
/gps/energy 9.68 eV
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0. 0. -2. cm
/gps/pos/radius 7 mm
/gps/direction 0 0 1
