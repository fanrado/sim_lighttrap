# ─────────────────────────────────────────────────────────────────────────────
# vis.mac — interactive Qt visualisation (executed automatically by ./sim_lighttrap
# with no arguments, or ./sim_lighttrap vis.mac).
#
# Shows the first layer (pTP film: yellow, UV acrylic: light blue) and the PMT
# cylinder (MgF2 faceplate at z = 0, dark red photocathode Ø 23 mm behind it,
# grey glass envelope). The 14 mm circular VUV beam is preloaded: use the Run
# menu or "/run/beamOn 30" to see trajectories.
# ─────────────────────────────────────────────────────────────────────────────
/vis/open Qt3D
/vis/drawVolume
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
/vis/scene/add/scale 10 cm
/vis/scene/add/axes
/vis/scene/add/trajectories smooth
# (no /vis/scene/add/eventID: the Qt3D driver cannot draw 2D text and would print
#  the harmless "qt3D-0001 ... 2D drawing not yet implemented" warning instead)
/vis/scene/endOfEventAction accumulate

# File menu :
/gui/addMenu file File
/gui/addButton file Quit exit

# Camera menu:
/gui/addMenu camera Camera
/gui/addButton camera "Front" "/vis/viewer/set/viewpointVector 0 0 1"
/gui/addButton camera "Side"  "/vis/viewer/set/viewpointVector -1 0 0"
/gui/addButton camera "Top"   "/vis/viewer/set/viewpointVector 0 -1 0"
/gui/addButton camera "Reset"   "/vis/viewer/set/viewpointVector -1 1 1"

# Run menu :
/gui/addMenu run Run
/gui/addButton run "beamOn 10"  "/run/beamOn 10"
/gui/addButton run "beamOn 200" "/run/beamOn 1000"
/gui/addButton run "Redraw (rebuild view)" "/vis/viewer/rebuild"
# After every run a "sim_lighttrap run N summary" block is printed in the
# Output pane (beam photons, WLS photons born in pTP, photons on the PMT):
# use it to validate the physics independently of what the viewer draws.

# 14 mm diameter parallel VUV beam (same as run.mac).
# The source must be INSIDE the world box (half-length 18.2 cm in z by default):
# a source outside it is rejected at /run/beamOn. To start the beam farther from
# the sample, enlarge the world first, e.g.
#   /detector/worldHalfZ 300   (mm)   then  /run/reinitializeGeometry  and  /run/initialize
/gps/particle opticalphoton
/gps/energy 9.68 eV
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0. 0. -18. cm
/gps/pos/radius 7 mm
/gps/direction 0 0 1
