# ─────────────────────────────────────────────────────────────────────────────
# vis_roughness.mac — SEE the roughness of the pTP layer.
#
#     cd build && ./sim_lighttrap vis_roughness.mac
#
# Opens the Qt viewer with an exaggerated, physically bumpy pTP film (random
# height map on the beam-facing face) and shoots a 400 nm beam through it:
# 400 nm is not absorbed by pTP, so you see each ray deflected by the bump it
# hits. Zoom in on the yellow film (side view) to see the bumps themselves.
#
# THE KNOBS live in roughness_knobs.mac (film thickness, bumps per side, RMS
# bump height) — edit that file; it is shared with draw_offscreen.mac (ROUGH=1).
# ─────────────────────────────────────────────────────────────────────────────
/control/execute roughness_knobs.mac

# Same camera setup as vis.mac (default up vector, so the mouse rotates freely):
# beam comes from the left, sample in the middle, PMT on the right.
/vis/open Qt3D
/vis/drawVolume
/vis/viewer/set/viewpointVector -1 0 0
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
/vis/scene/add/scale 10 cm
/vis/scene/add/axes
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

/gui/addMenu camera Camera
/gui/addButton camera "Side (beam left → PMT right)" "/vis/viewer/set/viewpointVector -1 0 0"
/gui/addButton camera "Oblique"                      "/vis/viewer/set/viewpointThetaPhi 120 30 deg"
/gui/addButton camera "From the beam"                "/vis/viewer/set/viewpointVector 0 0 -1"
/gui/addButton camera "Zoom on the film (x8)"         "/vis/viewer/zoomTo 8"
/gui/addButton camera "Zoom reset"                   "/vis/viewer/zoomTo 1"
/gui/addMenu run Run
/gui/addButton run "beamOn 40 (400 nm, through the bumpy film)" "/run/beamOn 40"
/gui/addButton run "Redraw (rebuild view)" "/vis/viewer/rebuild"

/gps/particle opticalphoton
/gps/energy 3.0996 eV
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0. 0. -2. cm
/gps/pos/radius 7 mm
/gps/direction 0 0 1
/run/beamOn 40
