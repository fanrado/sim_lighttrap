# ─────────────────────────────────────────────────────────────────────────────
# run.mac  —  Standard batch run: 10 000 VUV photons, 14 mm diameter parallel beam.
#
# Coordinate reference: the PMT faceplate front sits at z = 0.
#   PMT (R6836)    ≈  z = 0 to 92 mm     (Ø 28.2 mm; MgF2 faceplate 0..1.5 mm,
#                                         photocathode Ø 23 mm behind it)
#   LAr gap        ≈  z = -7 to 0 mm
#   UV acrylic     ≈  z = -10 to -7 mm
#   pTP film       ≈  z = -10.002 to -10 mm
#
# The beam starts at z = -2 cm (10 mm in front of the pTP film), inside LAr,
# centred on the PMT axis, and travels in +z.
# ─────────────────────────────────────────────────────────────────────────────

/gps/particle opticalphoton
/gps/energy 9.68 eV
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0. 0. -2. cm
/gps/pos/radius 7 mm
/gps/direction 0 0 1
/run/beamOn 10000
