# ─────────────────────────────────────────────────────────────────────────────
# run_vuv_spectrum.mac  —  VUV spectrum batch run: 10 000 photons, planar square
#                          source with LAr scintillation spectrum (115–145 nm).
#
# Spectrum: Gaussian centred at 128 nm (9.69 eV), FWHM=10 nm (σ=4.25 nm).
# Energy range: 8.55 eV (145 nm) – 10.78 eV (115 nm).
# 13 histogram points sampled at 2.5 nm spacing; GPS normalises automatically.
#
# Source geometry: same as run.mac — square 15 cm × 15 cm at z = -2 cm,
# photons directed in +z toward the detector module.
# ─────────────────────────────────────────────────────────────────────────────

/gps/particle opticalphoton

# --- Source position (inside LAr, 8 mm in front of pTP film) ---
/gps/pos/type Plane
/gps/pos/centre 0. 0. -2. cm
/gps/pos/shape Square
/gps/pos/halfx 7.5 cm
/gps/pos/halfy 7.5 cm
/gps/direction 0 0 1

# --- VUV energy distribution: Gaussian in wavelength, tabulated in eV ---
/gps/ene/type Arb
/gps/hist/type arb
# energy(eV)  weight  [λ nm → Gaussian exp(-(λ-128)²/(2×4.25²))]
/gps/hist/point  8.5506  0.000336
/gps/hist/point  8.7006  0.002965
/gps/hist/point  8.8560  0.018612
/gps/hist/point  9.0170  0.081958
/gps/hist/point  9.1840  0.257840
/gps/hist/point  9.3571  0.571014
/gps/hist/point  9.5372  0.895023
/gps/hist/point  9.7242  0.993098
/gps/hist/point  9.9187  0.779403
/gps/hist/point 10.1211  0.432676
/gps/hist/point 10.3320  0.170325
/gps/hist/point 10.5518  0.047291
/gps/hist/point 10.7812  0.009334
/gps/hist/inter Lin

/run/beamOn 10000
