/gps/particle opticalphoton
/control/execute spectrum_macro.mac

# position: 14 mm beam in front of the pTP front face (z = -6 mm), inside world (z half = 9 cm)
/gps/pos/type Plane
/gps/pos/centre 0. 0. -2. cm
/gps/pos/shape Circle
/gps/pos/radius 7 mm

# shoot toward detector (+z direction)
/gps/direction 0 0 1

# Run the simulation with 1000 particles
/run/beamOn 1000
