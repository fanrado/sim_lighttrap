# run_285.mac — measured lamp spectrum (spectrum_macro.mac, generated by
# input/create_macro.py from input/spectrum.txt), 14 mm beam, 1000 photons.

# Rough pTP film: started with rough=on (main.sh: ROUGH=on) all settings of
# roughness_knobs.mac (film thickness, surface height map, sigmaAlpha) are
# applied here; with rough=off the film stays as configured in the YAML.
/control/if {ROUGH} == 1 roughness_knobs.mac

/gps/particle opticalphoton
/control/execute spectrum_macro.mac

# position: 14 mm beam in front of the pTP front face (z = -6 mm), inside world (z half = 9 cm)
/gps/pos/type Plane
/gps/pos/centre 0. 0. -2. cm
/gps/pos/shape Circle
/gps/pos/radius 7 mm

# shoot toward detector (+z direction)
/gps/direction 0 0 1

# Run the simulation with 1000 particles
/run/beamOn 1000
